# ---- server-only (never shipped to the browser) ------------------------------
# In Cloud Run this is the backend service URL + prefix, e.g.
# https://atelier-api-abc123-ew.a.run.app/api/v1
API_URL=http://localhost:8080/api/v1

# ---- public (inlined at build time) ------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CURRENCY=EGP
NEXT_PUBLIC_LOCALE=en-EG
NEXT_PUBLIC_GCS_BUCKET=
NEXT_PUBLIC_FREE_SHIPPING_CENTS=150000
NEXT_PUBLIC_FLAT_SHIPPING_CENTS=6000

# Locale is chosen per request (cookie -> Accept-Language -> 'en'), so there is
# no build-time language setting. NEXT_PUBLIC_LOCALE only affects the fallback
# Intl formatting used before a locale is resolved.
