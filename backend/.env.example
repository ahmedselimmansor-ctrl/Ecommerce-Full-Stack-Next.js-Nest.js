# ---- runtime ----------------------------------------------------------------
NODE_ENV=development
PORT=8080
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000
CURRENCY=EGP

# ---- Cloud SQL (PostgreSQL) --------------------------------------------------
# Local / docker-compose:
DATABASE_URL=postgresql://atelier:atelier@localhost:5432/atelier?schema=public
# Cloud Run with a private-IP instance reached through the VPC connector:
# DATABASE_URL=postgresql://USER:PASSWORD@10.x.x.3:5432/atelier?schema=public
# Cloud Run with the Cloud SQL unix socket (--add-cloudsql-instances):
# DATABASE_URL=postgresql://USER:PASSWORD@localhost/atelier?host=/cloudsql/PROJECT:REGION:INSTANCE&schema=public

# ---- Memorystore (Redis) -----------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
CACHE_TTL_SECONDS=120

# ---- auth --------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-dev-access-secret-at-least-16-chars
JWT_REFRESH_SECRET=change-me-dev-refresh-secret-at-least-16-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- Cloud Storage -----------------------------------------------------------
GCS_BUCKET=
GCS_PUBLIC_BASE_URL=
GOOGLE_CLOUD_PROJECT=

# ---- shipping rules ----------------------------------------------------------
FREE_SHIPPING_THRESHOLD_CENTS=150000
FLAT_SHIPPING_CENTS=6000

# ---- seed accounts -----------------------------------------------------------
SEED_ADMIN_EMAIL=admin@atelier.test
SEED_ADMIN_PASSWORD=Admin123!
SEED_CUSTOMER_EMAIL=customer@atelier.test
SEED_CUSTOMER_PASSWORD=Customer123!

# ---- Kashier payment gateway --------------------------------------------------
# Dashboard -> Developers. Leave empty to hide card payment entirely.
KASHIER_MERCHANT_ID=
KASHIER_API_KEY=
# Only set when Kashier issued a separate iframe/secret key; defaults to the API key.
KASHIER_SECRET_KEY=
KASHIER_MODE=test
KASHIER_BASE_URL=https://checkout.kashier.io
KASHIER_DISPLAY=en
KASHIER_ALLOWED_METHODS=card,wallet

# Public URLs used to build redirect and webhook targets.
STOREFRONT_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8080/api/v1
